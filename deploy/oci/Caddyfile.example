# Point both hostnames to the VM's public IP. Caddy provisions HTTPS for each.
# Keep the administrator interface on its own host while retaining server-side
# role checks in the app. Its session cookie has no Domain attribute, so it is
# scoped to the host where the administrator signs in.
lms.example.com {
    request_body {
        max_size 1GB
    }

    @adminPage {
        method GET
        path /control-center /control-center/*
    }
    handle @adminPage {
        redir https://admin.example.com{uri} 302
    }

    @adminOnly path /control-center /control-center/* /api/admin /api/admin/*
    handle @adminOnly {
        respond "Not found" 404
    }

    handle {
        reverse_proxy 127.0.0.1:3000
    }
}

admin.example.com {
    request_body {
        max_size 1GB
    }

    @adminRoutes path /control-center /control-center/* /api/admin /api/admin/*
    handle @adminRoutes {
        reverse_proxy 127.0.0.1:3000
    }

    # Shared endpoints and assets used by the admin shell.
    @adminAssets path /_next/* /branding/* /favicon.ico /api/auth/me /api/auth/me/* /api/auth/logout /api/avatars/* /api/me/wishlist /api/me/wishlist/*
    handle @adminAssets {
        reverse_proxy 127.0.0.1:3000
    }

    handle / {
        redir https://lms.example.com/ 302
    }
    handle /login {
        redir https://lms.example.com/login 302
    }
    handle {
        respond "Not found" 404
    }
}
