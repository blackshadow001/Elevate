# Development SQLite file. Use an absolute durable path in deployment.
DATABASE_URL=file:./data/learnly.sqlite
# Persist this directory with SQLite when deploying the single-server video upload path.
MEDIA_STORAGE_DIR=./data/media
# Public origin used for absolute social-sharing images. Set this to the deployed HTTPS origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:4500
# Required for PDF-reader-verifiable certificates. Use an absolute path to a private
# organization-owned PKCS#12 (.p12/.pfx) signing credential; never commit it.
# CERTIFICATE_SIGNING_P12_PATH=/etc/elevate/certificate-signing.p12
# CERTIFICATE_SIGNING_P12_PASSWORD=
# Required only when running the optional development seed command.
DEV_SEED_PASSWORD=replace-with-a-unique-local-password
# First-admin bootstrap only. Set these in a private operator environment, not in a committed .env file.
# ADMIN_BOOTSTRAP_NAME=Your Name
# ADMIN_BOOTSTRAP_EMAIL=admin@your-domain.example
# ADMIN_BOOTSTRAP_PASSWORD=unique-password-at-least-16-characters
# Razorpay checkout. Keep secrets in the server environment; leave blank to disable checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloud media and live streaming remain unimplemented. Email can use Resend for plan renewal reminders.
MEDIA_PROVIDER=none
LIVE_PROVIDER=none
EMAIL_PROVIDER=none
# Personal Plan subscriptions stay disabled until Razorpay recurring billing and a verified
# Resend sending domain are configured and tested. Never commit real secrets.
PERSONAL_PLAN_ENABLED=0
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=Elevate <billing@your-domain.example>
# SITE_URL=https://your-domain.example

# Google OAuth web client. Configure the exact callback URI in Google Cloud Console.
# GOOGLE_CREDENTIALS_FILE=./client_secret_your-web-client.json
# Or set GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET as server-only environment variables.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4500/api/auth/google/callback
