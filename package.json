{
  "name": "lms-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --webpack -p 4500",
    "build": "next build --webpack",
    "start": "node scripts/db.mjs && node scripts/start-server.mjs",
    "lint": "eslint",
    "db:migrate": "node scripts/db.mjs",
    "db:seed": "node scripts/seed.mjs",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs",
    "admin:reset-password": "node scripts/reset-admin-password.mjs",
    "media:cleanup": "node scripts/cleanup-discarded-videos.mjs",
    "test:backend": "node --test tests/backend/*.test.mjs",
    "test:browser": "playwright test tests/browser"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.0.0",
    "google-auth-library": "^11.2.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.53.0",
    "next": "16.4.1",
    "razorpay": "^2.9.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
